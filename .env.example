# App
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-a-strong-random-secret
CRON_SECRET=replace-with-a-strong-random-secret
ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# Database / queue
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/openreply
REDIS_URL=redis://localhost:6379
# Only for docker-compose.app.yml, and only if you changed the credentials in
# docker-compose.yml. Inside the containers the hosts are the service names.
# DOCKER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/openreply
# DOCKER_REDIS_URL=redis://redis:6379

# Email magic links (Resend)
RESEND_API_KEY=re_...
EMAIL_FROM=OpenReply <login@example.com>

# Required: an empty list denies all sign-ins. Values are non-secret settings.
ALLOWED_EMAILS=
# Enable only after sender verification and Luke's approval.
LOGIN_EMAIL_ENABLED=false
META_CONNECTIONS_ENABLED=false
OUTBOUND_MESSAGES_ENABLED=false
# This fork uses Resend only; SMTP is deliberately not installed.

# Meta / Instagram
META_GRAPH_API_VERSION=v25.0
INSTAGRAM_APP_ID=your-instagram-app-id
INSTAGRAM_APP_SECRET=your-instagram-app-secret
FACEBOOK_APP_SECRET=your-facebook-app-secret
WEBHOOK_VERIFY_TOKEN=replace-with-a-webhook-verify-token

# Optional: Meta apps created from October 2026 only offer "API setup with
# Unified login". Set its login configuration ID to connect new accounts that
# way, with the Meta app's own ID (App settings > Basic) and FACEBOOK_APP_SECRET.
# The configuration needs business_management (see docs/setup.md). Accounts
# already connected through Instagram Login keep working either way.
# META_LOGIN_CONFIG_ID=
# META_APP_ID=

# Optional. A GitHub token (no scopes needed) raises the rate limit for the star count
# and contributors list on the public pages. Without it they fall back to asking
# GitHub from the visitor's browser.
# GITHUB_TOKEN=
